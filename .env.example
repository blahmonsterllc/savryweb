# ============================================
# ADMIN PANEL SECURITY (Google OAuth)
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000

# ============================================
# iOS APP AUTHENTICATION
# ============================================
# JWT secret for iOS app tokens (used by verifyJWT)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-for-ios-app
# Keep false until the legacy Firebase API is fully replaced and its contract
# tests pass. The website does not need these routes.
ENABLE_LEGACY_APP_API=false

# ============================================
# SUPABASE / POSTGRESQL (PRIMARY COMMUNITY DATABASE)
# ============================================
# Public values from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SAVRY_DATA_BACKEND=supabase
# Pooled PostgreSQL URL for Prisma, scripts, and migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for schema migrations.
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ============================================
# LEGACY FIREBASE (REMOVE AFTER MIGRATION VALIDATION)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ============================================
# SAVRY RECIPE MODEL (no ChatGPT fallback)
# ============================================
SAVRY_MODEL_URL=http://localhost:8090/v1/recipes/generate
SAVRY_MODEL_API_KEY=replace-with-a-service-to-service-key
SAVRY_MODEL_ID=savry-recipe-v1

# ============================================
# TASTEFUL WEBSITE ADVERTISING (OPTIONAL)
# ============================================
# Ads remain off until a client ID and placement-specific slot are configured.
# Visitors must also consent before the Google script is loaded.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_FEED_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_RECIPE_SLOT=

# ============================================
# LEGACY OPTIONAL AI FEATURES
# ============================================
# Not used by /api/app/recipes/generate or the Savry Chef interface.
OPENAI_API_KEY=

# ============================================
# OPTIONAL: Old Password System (Deprecated)
# ============================================
# These are no longer used but kept for backwards compatibility
# ADMIN_PASSWORD=old-password-system-deprecated
# ADMIN_SESSION_SECRET=old-session-system-deprecated
