# Every environment variable the website reads, with placeholders only.
# Set real values in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Only NEXT_PUBLIC_* values reach browsers; every
# other value stays on the server.
# /admin/security checks most of these on the live site.

# ============================================
# PUBLIC SITE URL
# ============================================
# Canonical public origin: scheme + host, no path, no trailing slash. Feeds
# canonical links, Open Graph URLs, robots.txt, the sitemap, links handed to the
# iOS app, and the Cloudflare Access redirect. /admin/security expects exactly this value.
NEXT_PUBLIC_SITE_URL=https://www.savry.io

# ============================================
# SUPABASE (database, auth, storage)
# ============================================
# Public values from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ============================================
# ADMIN SIGN-IN (docs/admin-security.md)
# ============================================
# Admins sign in with their own Savry account (Apple or email), must be listed
# in public.admin_users, and must enter an authenticator-app code (two-factor).
# Cloudflare Access adds its own sign-in in front of /admin and /api/admin.
# Both values come from Cloudflare Zero Trust and are not secret.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-the-application-audience-tag

# ============================================
# VISIT COUNTS (Cloudflare Web Analytics, cookie-free)
# ============================================
# The beacon token is public (it is in every page). Leave empty to switch counting off.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# For the numbers on the admin overview. The API token is secret: create it with
# only "Account Analytics: Read".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: only if the Cloudflare account counts more than one site.
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=

# ============================================
# ANTHROPIC (Savry Chef, kitchen scan, content patrol)
# ============================================
# Required: Savry Chef and the kitchen scan in the iOS app answer 503 without it,
# and the content patrol stays off. Server only.
ANTHROPIC_API_KEY=
# Optional model overrides (defaults are in lib/ai-recipes.ts, lib/ai-pantry.ts, lib/patrol.ts).
AI_RECIPE_MODEL=
AI_PANTRY_MODEL=
PATROL_MODEL=

# ============================================
# SCHEDULED JOBS
# ============================================
# Bearer token Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# ============================================
# EMAIL (Resend)
# ============================================
# The weekly email. Auth email goes through Supabase's SMTP setting (scripts/auth/smtp.mjs).
RESEND_API_KEY=

# ============================================
# APPLE
# ============================================
# Sign in with Apple token revocation when a member deletes their account
# (Apple requires it). The private key is the .p8 file's contents. Server only.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=recipe.foodprep
# App Review and TestFlight buy Savry+ in Apple's sandbox. Keep "true" at least
# until the app is approved, or the reviewer's Savry+ does not unlock server features.
APP_STORE_ALLOW_SANDBOX=true

# ============================================
# GROCERY PRICES
# ============================================
# Kroger shelf prices for Savry+ (developer.kroger.com). Server only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# BLS_API_KEY is a GitHub Actions secret for the monthly price refresh, not a Vercel variable.

# ============================================
# SEARCH CONSOLE (optional)
# ============================================
# The verification token only, not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
