# ============================================
# ADMIN PANEL
# ============================================
# No variables. Admins sign in with their own Savry account (Apple or email)
# and are listed by user id in the public.admin_users table.

# ============================================
# PUBLIC SITE URL
# ============================================
# Canonical public origin of the website. It MUST be the public https origin
# (scheme + host, no path, no trailing slash), e.g. https://savry.io. It feeds
# canonical links, Open Graph URLs, robots.txt, the sitemap, and links handed to
# the iOS app. Leave unset locally to fall back to the Vercel preview URL.
NEXT_PUBLIC_SITE_URL=https://savry.io

# ============================================
# iOS APP AUTHENTICATION
# ============================================

# ============================================
# SUPABASE / POSTGRESQL (PRIMARY COMMUNITY DATABASE)
# ============================================
# Public values from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ============================================
# SAVRY RECIPE MODEL (no ChatGPT fallback)
# ============================================
SAVRY_MODEL_URL=http://localhost:8090/v1/recipes/generate
SAVRY_MODEL_API_KEY=replace-with-a-service-to-service-key
SAVRY_MODEL_ID=savry-recipe-v1

# ============================================
# TASTEFUL WEBSITE ADVERTISING (OPTIONAL)
# ============================================
# Ads remain off until a client ID and placement-specific slot are configured.
# Setting the client ID also loads Google's certified consent (Privacy &
# messaging) script and serves /ads.txt for the same publisher id.
# Savry+ members never see ads.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_FEED_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_RECIPE_SLOT=
# Paste the verification token only (not the full meta tag) from Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ============================================
# OPTIONAL: Old Password System (Deprecated)
# ============================================
# These are no longer used but kept for backwards compatibility
# ADMIN_PASSWORD=old-password-system-deprecated
# ADMIN_SESSION_SECRET=old-session-system-deprecated
